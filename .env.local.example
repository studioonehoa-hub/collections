# Supabase project settings (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Direct Postgres connection string (Project Settings → Database → Connection string → URI)
# Used only by drizzle-kit to generate/push migrations, never at app runtime.
DATABASE_URL=postgresql://postgres:password@db.xxxxxxxx.supabase.co:5432/postgres

# Intentionally no SUPABASE_SERVICE_ROLE_KEY here — this app never uses the
# service role. All data access goes through the anon key + a user's JWT,
# so RLS is always enforced (see supabase/sql/rls_policies.sql).
